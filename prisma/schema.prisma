generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ARCHIVED
}

model Project {
  id         String        @id @default(cuid())
  name       String
  owner      String
  status     ProjectStatus @default(PLANNING)
  carbonTons Float         @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
