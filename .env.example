# Local dev: Postgres on localhost
# Production (Vercel + Supabase): use the Supabase pooler URL (port 6543)
# DATABASE_URL is what the app reads at runtime. On Supabase, copy the
# "Connection pooling" string and append ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://esg_user:esg_password@localhost:5432/esg_demo?schema=public"

# Only required when running prisma migrate / db push against Supabase.
# Use the "Direct connection" string from Supabase (port 5432).
# Leave unset for local dev — Prisma will fall back to DATABASE_URL.
# DIRECT_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"

# Optional. If not set, the API skips Redis (in-memory only).
REDIS_URL="redis://localhost:6379"

# Local dev only. Vercel injects its own port for the function runtime.
PORT=8787
